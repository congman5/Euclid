################################################################################
# .gitignore — Euclid Elements Simulator
################################################################################

# ── IDE / editor ──
/.vs
.vscode/
*.suo
*.user
*.sln.docstates

# ── Python bytecode ──
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribution / packaging ──
dist/
build/
*.egg-info/
*.egg
*.whl
*.spec

# ── Virtual environments ──
.venv/
venv/
env/

# ── Node (not used at runtime, leftover from earlier tooling) ──
node_modules/

# ── Test / coverage ──
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Logs and crash dumps ──
euclid_crash.log

# ── Debug / scratch output (root level) ──
_stderr.txt
_stdout*.txt
_test.txt
_tmp.txt
_verify_results.txt
_i17.json
trace_out.txt
dump_*.txt
debug_*_out.txt

# ── Debug / scratch scripts (root level) ──
/_*.py
/debug_*.py
/dump_*.py
/verify_prop*.py
/test_prop*.py
/test_parse_prime.py

# ── Verifier test debug output ──
verifier/tests/debug_*
verifier/tests/synth_*

# ── Misc temp / scratch files ──
test.euclid
test_out.txt
test_err.txt
user_bookmarks.json
instructions.txt
*.new
